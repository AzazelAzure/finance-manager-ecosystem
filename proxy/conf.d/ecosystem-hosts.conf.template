# Ecosystem hostnames — additive vhosts for Orchestrator, ops console, and Portfolio edge.
# Mounted separately for future extraction to standalone edge-proxy. Does not modify HFM blue/green maps.
# Render via scripts/ops/render_ecosystem_hosts.sh → ecosystem-hosts.deploy.conf (not this tracked file).
# Upstreams use per-color Podman DNS aliases on orchestrator-console-{color} networks (proxy must attach).

    map $orch_active_color $orch_api_upstream {
        default orch-api-blue:8000;
        blue    orch-api-blue:8000;
        green   orch-api-green:8000;
    }

    map $orch_active_color $orch_console_upstream {
        default orch-console-blue:8081;
        blue    orch-console-blue:8081;
        green   orch-console-green:8081;
    }

    upstream external_adapter_upstream {
        server host.containers.internal:3000;
    }

    server {
        listen 443 ssl;
        server_name api.thedirectorate.app;

        ssl_certificate     /etc/nginx/certs/thedirectorate.app.pem;
        ssl_certificate_key /etc/nginx/certs/thedirectorate.app-key.pem;

        location / {
            proxy_pass http://$orch_api_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port 443;
        }
    }

    server {
        listen 443 ssl;
        server_name www.thedirectorate.app;

        ssl_certificate     /etc/nginx/certs/thedirectorate.app.pem;
        ssl_certificate_key /etc/nginx/certs/thedirectorate.app-key.pem;

        location / {
            proxy_pass http://$orch_console_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port 443;
        }
    }

    server {
        listen 443 ssl;
        server_name pproctor.com;

        ssl_certificate     /etc/nginx/certs/pproctor.com.pem;
        ssl_certificate_key /etc/nginx/certs/pproctor.com-key.pem;

        location / {
            proxy_pass http://external_adapter_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port 443;
        }
    }

    server {
        listen 443 ssl;
        server_name preview.pproctor.com;

        ssl_certificate     /etc/nginx/certs/pproctor.com.pem;
        ssl_certificate_key /etc/nginx/certs/pproctor.com-key.pem;

        add_header X-Robots-Tag "noindex, nofollow" always;

        location / {
            proxy_pass http://external_adapter_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port 443;
        }
    }

    server {
        listen 443 ssl;
        server_name www.pproctor.com;

        ssl_certificate     /etc/nginx/certs/pproctor.com.pem;
        ssl_certificate_key /etc/nginx/certs/pproctor.com-key.pem;

        return 301 https://pproctor.com$request_uri;
    }

    server {
        listen 80;
        server_name www.pproctor.com;
        return 301 https://pproctor.com$request_uri;
    }

    server {
        listen 80;
        server_name api.thedirectorate.app www.thedirectorate.app pproctor.com preview.pproctor.com;
        return 301 https://$host$request_uri;
    }
